# Local dev secrets for `wrangler dev` (Cloudflare Workers). Copy to .dev.vars and fill in.
# Brevo API key for transactional email (password reset, admin notices).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the verified from-address (defaults to noreply@shouldiboat.com).
# EMAIL_FROM=noreply@shouldiboat.com
# Optional: Windy Webcams API key. When set, spots without a curated cam
# (built pages, coastal spots) auto-show the nearest Windy webcam.
# WINDY_WEBCAMS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
