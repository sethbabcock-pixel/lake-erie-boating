{
  "name": "lake-erie-boating",
  "compatibility_date": "2024-11-01",
  "main": "worker.js",
  // run_worker_first: assets are normally served before the Worker runs, which
  // meant the www→apex redirect (and security headers) never applied to page
  // loads. Routing everything through the Worker fixes that; worker.js serves
  // the assets itself via the ASSETS binding.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "build": { "command": "npm install && npm run build" },
  "kv_namespaces": [
    { "binding": "USERS", "id": "ab7226cefa2d4f8a805b4ecb1b23775b" }
  ],
  // Hourly: NO-GO alert emails each run (daytime ET only); the 10:00 UTC run
  // (6am ET) also sends the daily "your ports" verdict digest.
  "triggers": { "crons": ["0 * * * *"] }
}
